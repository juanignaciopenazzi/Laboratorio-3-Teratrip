              "stat": "Average",
              "label": "Promedio"
            }
          ],
          [
            "AWS/States",
            "ExecutionTime",
            "StateMachineArn",
            "arn:aws:states:us-east-1:955030484229:stateMachine:sfn-teratrip-ingest",
            {
              "stat": "Maximum",
              "label": "Máximo"
            }
          ]
        ],
        "yAxis": {
          "left": {
            "min": 0,
            "label": "ms"
          }
        }
      }
    },
