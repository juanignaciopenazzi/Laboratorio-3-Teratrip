    {
      "type": "log",
      "x": 0,
      "y": 29,
      "width": 24,
      "height": 8,
      "properties": {
        "title": "Errores — las cuatro Lambdas y el Glue Job en un solo lugar",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/lambda-teratrip-textract-extract' | SOURCE '/aws/lambda/lambda-teratrip-normalize' | SOURCE '/aws/lambda/lambda-teratrip-athena-query' | SOURCE '/aws-glue/jobs/error'\n| fields @timestamp, @log, @message\n| filter @message like /(?i)(error|exception|traceback|rechazad|descartad|fallo)/\n| sort @timestamp desc\n| limit 50"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 37,
      "width": 12,
      "height": 8,
      "properties": {
        "title": "Merge — qué incorporó y qué descartó cada corrida",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws-glue/jobs/output'\n| fields @timestamp, @message\n| filter @message like /(Tabla sabana|anti-join|A incorporar|Registros recibidos|Backup|Todos los booking_id)/\n| sort @timestamp desc\n| limit 60"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 37,
      "width": 12,
      "height": 8,
      "properties": {
        "title": "Agente — SQL generado y consultas rechazadas",
        "region": "us-east-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/lambda-teratrip-athena-query'\n| fields @timestamp, @message\n| filter @message like /(SQL ejecutado|RECHAZADO|QueryExecutionId)/\n| sort @timestamp desc\n| limit 60"
      }
    }
