{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerElDocumentoSubido",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::teratrip-data-lake-955030484229/incoming-documents/*"
    },
    {
      "Sid": "GuardarElJsonCrudoDeTextract",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::teratrip-data-lake-955030484229/textract-raw/*"
    },
    {
      "Sid": "AnalizarTablasConTextract",
      "Effect": "Allow",
      "Action": "textract:AnalyzeDocument",
      "Resource": "*"
    },
    {
      "Sid": "EscribirSusPropiosLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:955030484229:log-group:/aws/lambda/lambda-teratrip-textract-extract:*"
    },
    {
      "Sid": "CrearSuGrupoDeLogs",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-1:955030484229:*"
    }
  ]
}
