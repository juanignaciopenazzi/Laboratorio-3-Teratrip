{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PasarElRolDeGlueAlServicioGlue",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::955030484229:role/AWSGlueServiceRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "glue.amazonaws.com"
        }
      }
    }
  ]
}
